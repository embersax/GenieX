+//
+// hprof: host-side end-to-end timeline (diagnostic builds, see ggml-hprof.h)
+//
+
+#include "ggml-hprof.h"
+
+#include <atomic>
+#include <cstdarg>
+#include <string>
+#include <utility>
+
+#if defined(__linux__)
+#include <sched.h>
+#include <unistd.h>
+#endif
+
+namespace {
+
+struct ggml_hprof_event {
+    int64_t  t;
+    int32_t  kind;
+    uint64_t a;
+    uint64_t b;
+    uint64_t c;
+    uint64_t d;
+    char     name[128];
+};
+
+struct ggml_hprof_state {
+    int                            max_split_nodes = 16;
+    int                            max_decodes     = 512;   // stop recording after this many llama_decode calls (bounds the log size)
+    int                            n_decodes       = 0;
+    bool                           stopped         = false;
+    bool                           stop_printed    = false;
+    std::atomic<bool>              lock{false};
+    std::vector<ggml_hprof_event>  events;
+    std::string                    text;
+    size_t                         dropped = 0;
+    // current scheduler split (for NODE_DONE)
+    int                            cur_split       = -1;
+    int                            cur_split_nodes = 0;
+    int                            cur_node_k      = 0;
+    char                           cur_backend[32] = {0};
+    // system sampling at dump time
+    int                            sys_ms       = 500;
+    int64_t                        sys_last_us  = 0;
+    uint64_t                       sys_idx      = 0;
+    std::vector<std::pair<std::string, std::string>> sys_files; // key, path
+};
+
+std::atomic<int> g_hprof_enabled{-1}; // -1 not initialised, 0 off (or stopped), 1 recording
+
+ggml_hprof_state & ggml_hprof_get() {
+    static ggml_hprof_state st;
+    return st;
+}
+
+void ggml_hprof_lock(ggml_hprof_state & st) {
+    while (st.lock.exchange(true, std::memory_order_acquire)) {
+    }
+}
+
+void ggml_hprof_unlock(ggml_hprof_state & st) {
+    st.lock.store(false, std::memory_order_release);
+}
+
+const char * ggml_hprof_kind_name(int kind) {
+    switch (kind) {
+        case GGML_HPROF_DECODE_BEGIN:     return "DECODE_BEGIN";
+        case GGML_HPROF_DECODE_END:       return "DECODE_END";
+        case GGML_HPROF_UBATCH_BEGIN:     return "UBATCH_BEGIN";
+        case GGML_HPROF_GRAPH_READY:      return "GRAPH_READY";
+        case GGML_HPROF_INPUTS_SET:       return "INPUTS_SET";
+        case GGML_HPROF_UBATCH_END:       return "UBATCH_END";
+        case GGML_HPROF_SCHED_BEGIN:      return "SCHED_BEGIN";
+        case GGML_HPROF_SCHED_END:        return "SCHED_END";
+        case GGML_HPROF_SPLIT_BEGIN:      return "SPLIT_BEGIN";
+        case GGML_HPROF_SPLIT_COPIED:     return "SPLIT_COPIED";
+        case GGML_HPROF_SPLIT_END:        return "SPLIT_END";
+        case GGML_HPROF_SPLIT_NODE:       return "SPLIT_NODE";
+        case GGML_HPROF_GET_TENSOR_BEGIN: return "GET_TENSOR_BEGIN";
+        case GGML_HPROF_GET_TENSOR_END:   return "GET_TENSOR_END";
+        case GGML_HPROF_SYNC_BEGIN:       return "SYNC_BEGIN";
+        case GGML_HPROF_SYNC_END:         return "SYNC_END";
+        case GGML_HPROF_HEX_SEND:         return "HEX_SEND";
+        case GGML_HPROF_HEX_RECV:         return "HEX_RECV";
+        case GGML_HPROF_HEX_WAIT_BEGIN:   return "HEX_WAIT_BEGIN";
+        case GGML_HPROF_HEX_WAIT_END:     return "HEX_WAIT_END";
+        case GGML_HPROF_NODE_DONE:        return "NODE_DONE";
+        case GGML_HPROF_SYS:              return "SYS";
+        default:                          return "UNKNOWN";
+    }
+}
+
+// read a small sysfs file into buf (without the trailing newline); false if unreadable
+bool ggml_hprof_read_small(const char * path, char * buf, size_t n) {
+    FILE * f = fopen(path, "r");
+    if (!f) {
+        return false;
+    }
+    const size_t got = fread(buf, 1, n - 1, f);
+    fclose(f);
+    buf[got] = 0;
+    for (size_t i = 0; i < got; i++) {
+        if (buf[i] == '\n' || buf[i] == '\r') {
+            buf[i] = 0;
+            break;
+        }
+    }
+    return got > 0;
+}
+
+// Build the list of sysfs files sampled at dump time (Linux/Android only).
+void ggml_hprof_sys_init(ggml_hprof_state & st) {
+#if defined(__linux__)
+    // thermal zones whose type names a part we care about (cpu clusters, nsp/cdsp, gpu, skin, ddr, soc, battery)
+    static const char * wanted[] = { "cpu", "nsp", "cdsp", "npu", "gpu", "skin", "ddr", "soc", "batt", "modem", "xo" };
+    for (int i = 0; i < 160 && st.sys_files.size() < 32; i++) {
+        char path[128];
+        char type[96];
+        snprintf(path, sizeof(path), "/sys/class/thermal/thermal_zone%d/type", i);
+        if (!ggml_hprof_read_small(path, type, sizeof(type))) {
+            if (i > 8) {
+                break; // zones are numbered contiguously
+            }
+            continue;
+        }
+        bool keep = false;
+        for (const char * w : wanted) {
+            if (strstr(type, w)) {
+                keep = true;
+                break;
+            }
+        }
+        if (!keep) {
+            continue;
+        }
+        snprintf(path, sizeof(path), "/sys/class/thermal/thermal_zone%d/temp", i);
+        st.sys_files.emplace_back(std::string("thermal:") + type, path);
+    }
+    for (int i = 0; i < 16; i++) {
+        char path[128];
+        char val[32];
+        snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpufreq/policy%d/scaling_cur_freq", i);
+        if (ggml_hprof_read_small(path, val, sizeof(val))) {
+            char key[32];
+            snprintf(key, sizeof(key), "cpufreq:policy%d", i);
+            st.sys_files.emplace_back(key, path);
+        }
+    }
+#else
+    (void) st;
+#endif
+}
+
+// Print one SYS line per sampled file (called inside the DUMP window, rate limited by sys_ms).
+void ggml_hprof_sys_sample(ggml_hprof_state & st) {
+    if (st.sys_ms <= 0 || st.sys_files.empty()) {
+        return;
+    }
+    const int64_t now = ggml_time_us();
+    if (st.sys_last_us && now - st.sys_last_us < (int64_t) st.sys_ms * 1000) {
+        return;
+    }
+    st.sys_last_us = now;
+    int cpu = -1;
+#if defined(__linux__)
+    cpu = sched_getcpu();
+#endif
+    for (const auto & kv : st.sys_files) {
+        char val[32];
+        if (!ggml_hprof_read_small(kv.second.c_str(), val, sizeof(val))) {
+            continue;
+        }
+        fprintf(stderr, "HPROF %lld SYS %llu %lld %d 0 %s\n", (long long) ggml_time_us(), (unsigned long long) st.sys_idx,
+                (long long) strtoll(val, NULL, 10), cpu, kv.first.c_str());
+    }
+    st.sys_idx++;
+}
+
+} // namespace
+
+extern "C" {
+
+int ggml_hprof_enabled(void) {
+    const int e = g_hprof_enabled.load(std::memory_order_relaxed);
+    if (e >= 0) {
+        return e;
+    }
+    static const int init = [] {
+        const char * env = getenv("GGML_HPROF");
+        const int on = (env == nullptr || atoi(env) != 0) ? 1 : 0;
+        if (on) {
+            ggml_hprof_state & st = ggml_hprof_get();
+            const char * nodes = getenv("GGML_HPROF_NODES");
+            if (nodes) {
+                st.max_split_nodes = atoi(nodes);
+            }
+            const char * maxd = getenv("GGML_HPROF_MAX_DECODES");
+            if (maxd) {
+                st.max_decodes = atoi(maxd);
+            }
+            const char * sysms = getenv("GGML_HPROF_SYS_MS");
+            if (sysms) {
+                st.sys_ms = atoi(sysms);
+            }
+            if (st.sys_ms > 0) {
+                ggml_hprof_sys_init(st);
+            }
+            st.events.reserve(1u << 16);
+            st.text.reserve(1u << 22);
+            fprintf(stderr, "HPROF %lld INIT %d %zu 0 %d ggml\n", (long long) ggml_time_us(), st.max_decodes, st.sys_files.size(), st.max_split_nodes);
+            atexit(ggml_hprof_dump);
+        }
+        g_hprof_enabled.store(on, std::memory_order_relaxed);
+        return on;
+    }();
+    return init;
+}
+
+int ggml_hprof_max_split_nodes(void) {
+    return ggml_hprof_get().max_split_nodes;
+}
+
+void ggml_hprof_set_split(int split_id, int n_nodes, const char * backend) {
+    ggml_hprof_state & st = ggml_hprof_get();
+    ggml_hprof_lock(st);
+    st.cur_split       = split_id;
+    st.cur_split_nodes = n_nodes;
+    st.cur_node_k      = 0;
+    if (backend) {
+        strncpy(st.cur_backend, backend, sizeof(st.cur_backend) - 1);
+        st.cur_backend[sizeof(st.cur_backend) - 1] = 0;
+    } else {
+        st.cur_backend[0] = 0;
+    }
+    ggml_hprof_unlock(st);
+}
+
+void ggml_hprof_node_done(void) {
+    if (!ggml_hprof_enabled()) {
+        return;
+    }
+    ggml_hprof_state & st = ggml_hprof_get();
+    ggml_hprof_lock(st);
+    const int  split = st.cur_split;
+    const int  k     = st.cur_node_k++;
+    const bool emit  = split >= 0 && st.cur_split_nodes <= st.max_split_nodes;
+    char backend[32];
+    memcpy(backend, st.cur_backend, sizeof(backend));
+    ggml_hprof_unlock(st);
+    if (emit) {
+        ggml_hprof_ev(GGML_HPROF_NODE_DONE, (uint64_t) split, (uint64_t) k, 0, 0, backend);
+    }
+}
+
+void ggml_hprof_ev(int kind, uint64_t a, uint64_t b, uint64_t c, uint64_t d, const char * name) {
+    ggml_hprof_event ev;
+    ev.t    = ggml_time_us();
+    ev.kind = kind;
+    ev.a    = a;
+    ev.b    = b;
+    ev.c    = c;
+    ev.d    = d;
+    if (name) {
+        strncpy(ev.name, name, sizeof(ev.name) - 1);
+        ev.name[sizeof(ev.name) - 1] = 0;
+    } else {
+        ev.name[0] = 0;
+    }
+
+    ggml_hprof_state & st = ggml_hprof_get();
+    ggml_hprof_lock(st);
+    if (st.events.size() < (1u << 20)) {
+        st.events.push_back(ev);
+    } else {
+        st.dropped++;
+    }
+    if (kind == GGML_HPROF_DECODE_END && st.max_decodes > 0 && ++st.n_decodes >= st.max_decodes && !st.stopped) {
+        // capture window over: stop recording (and stop the hexagon per-op lines) to bound the log
+        st.stopped = true;
+        g_hprof_enabled.store(0, std::memory_order_relaxed);
+    }
+    ggml_hprof_unlock(st);
+}
+
+void ggml_hprof_puts(const char * s, size_t len) {
+    if (!len) {
+        return;
+    }
+    if (!ggml_hprof_enabled()) {
+        if (ggml_hprof_get().stopped) {
+            return; // capture window over
+        }
+        fwrite(s, 1, len, stderr); // hprof disabled: behave like a plain fprintf(stderr)
+        return;
+    }
+
+    ggml_hprof_state & st = ggml_hprof_get();
+    ggml_hprof_lock(st);
+    if (st.text.size() + len > (64u << 20)) {
+        // buffer full: fall back to immediate output rather than losing the line
+        fwrite(st.text.data(), 1, st.text.size(), stderr);
+        st.text.clear();
+    }
+    st.text.append(s, len);
+    ggml_hprof_unlock(st);
+}
+
+void ggml_hprof_logf(const char * fmt, ...) {
+    char buf[1024];
+    va_list args;
+    va_start(args, fmt);
+    const int n = vsnprintf(buf, sizeof(buf), fmt, args);
+    va_end(args);
+    if (n <= 0) {
+        return;
+    }
+    const size_t len = (size_t) n < sizeof(buf) ? (size_t) n : sizeof(buf) - 1;
+    ggml_hprof_puts(buf, len);
+}
+
+void ggml_hprof_dump(void) {
+    ggml_hprof_state & st = ggml_hprof_get();
+
+    std::vector<ggml_hprof_event> events;
+    std::string text;
+    size_t dropped = 0;
+    bool print_stop = false;
+
+    ggml_hprof_lock(st);
+    events.swap(st.events);
+    text.swap(st.text);
+    dropped = st.dropped;
+    st.dropped = 0;
+    if (st.stopped && !st.stop_printed) {
+        st.stop_printed = true;
+        print_stop = true;
+    }
+    ggml_hprof_unlock(st);
+
+    if (events.empty() && text.empty() && !print_stop) {
+        return;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    for (const ggml_hprof_event & ev : events) {
+        fprintf(stderr, "HPROF %lld %s %llu %llu %llu %llu %s\n", (long long) ev.t, ggml_hprof_kind_name(ev.kind),
+                (unsigned long long) ev.a, (unsigned long long) ev.b, (unsigned long long) ev.c, (unsigned long long) ev.d,
+                ev.name[0] ? ev.name : "-");
+    }
+    if (!text.empty()) {
+        fwrite(text.data(), 1, text.size(), stderr);
+    }
+    if (!st.stopped) {
+        ggml_hprof_sys_sample(st); // only the dumping thread calls this; st.sys_* is not touched elsewhere
+    }
+    if (print_stop) {
+        fprintf(stderr, "HPROF %lld STOP %d 0 0 0 -\n", (long long) ggml_time_us(), st.n_decodes);
+    }
+    fflush(stderr);
+    const int64_t t1 = ggml_time_us();
+    fprintf(stderr, "HPROF %lld DUMP %lld %zu %zu %zu -\n", (long long) t0, (long long) t1, events.size(), text.size(), dropped);
+
+    // hand the (cleared) buffers back so that no reallocation happens during the next window
+    events.clear();
+    text.clear();
+    ggml_hprof_lock(st);
+    if (st.events.capacity() < events.capacity()) {
+        st.events.swap(events);
+    }
+    if (st.text.capacity() < text.capacity()) {
+        st.text.swap(text);
+    }
+    ggml_hprof_unlock(st);
+}
+
