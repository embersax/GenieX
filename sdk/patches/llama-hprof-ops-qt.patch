new file mode 100644
index 000000000..7fe1f74c9
--- /dev/null
+++ b/ggml/src/ggml-hprof.h
@@ -0,0 +1,99 @@
+// ggml-hprof.h -- host-side end-to-end timeline for llama.cpp inference (diagnostic builds only).
+//
+// Records timestamped events from llama_decode, the backend scheduler and the Hexagon backend
+// into an in-memory buffer and prints them to stderr only at dump points (end of llama_decode,
+// end of llama_context::synchronize, process exit), so that printing does not perturb the
+// measured window. The hexagon per-op profile lines are routed through the same buffer.
+//
+// Every line is prefixed with "HPROF " and parsed by profiler/hprof_parse.py.
+//
+// Environment:
+//   GGML_HPROF=0              disable (default: enabled -- diagnostic builds cannot receive env vars
+//                             through the device harness, so the patch is on by default)
+//   GGML_HPROF_NODES=N        list the nodes of splits with at most N nodes (default 16)
+//   GGML_HPROF_MAX_DECODES=N  stop recording after N llama_decode calls (default 512; bounds the log,
+//                             a decode call costs ~10 KB of host events, ~120 KB more with DSP per-op lines)
+//   GGML_HPROF_SYS_MS=N       at most every N ms, write SYS samples at dump time (Linux: thermal zones of
+//                             interest in m°C, cpufreq policies in kHz, cpu of the dumping thread); 0 disables
+//                             (default 500). The samples are taken inside the DUMP window so the parser
+//                             subtracts their cost.
+//
+// Per-node timing of small CPU splits: the scheduler tells hprof which split is running
+// (ggml_hprof_set_split) and llama-context installs a CPU abort-callback wrapper that calls
+// ggml_hprof_node_done after every computed node; for splits with at most GGML_HPROF_NODES nodes this
+// yields one NODE_DONE event per node, i.e. the per-op compute time of the CPU islands.
+
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include "ggml.h"
+// GGML_API: dllexport inside ggml-base (GGML_BUILD), dllimport in the backend and llama DLLs on Windows,
+// visibility("default") elsewhere. The hprof state lives in ggml-base (ggml-backend.cpp); the hexagon
+// backend and llama link against it.
+#define GGML_HPROF_API GGML_API
+
+enum ggml_hprof_kind {
+    GGML_HPROF_DECODE_BEGIN     = 1,  // a = n_tokens
+    GGML_HPROF_DECODE_END       = 2,  // a = return code
+    GGML_HPROF_UBATCH_BEGIN     = 3,  // a = n_tokens
+    GGML_HPROF_GRAPH_READY      = 4,  // a = 1 if the previous graph was reused, 0 if rebuilt + allocated
+    GGML_HPROF_INPUTS_SET       = 5,  // set_inputs done
+    GGML_HPROF_UBATCH_END       = 6,  // graph_compute returned, a = status
+    GGML_HPROF_SCHED_BEGIN      = 7,  // a = n_splits
+    GGML_HPROF_SCHED_END        = 8,
+    GGML_HPROF_SPLIT_BEGIN      = 9,  // a = split, b = backend id, c = n_nodes, d = n_inputs, name = backend
+    GGML_HPROF_SPLIT_COPIED     = 10, // a = split, c = input bytes copied (waits for other backends happen here)
+    GGML_HPROF_SPLIT_END        = 11, // a = split, graph_compute_async returned
+    GGML_HPROF_SPLIT_NODE       = 12, // a = split, b = ggml_op, c = ne0, d = ne1, name = "OP tensor dst<-src0,src1 ne(src0) ne(src1)" (small splits only)
+    GGML_HPROF_GET_TENSOR_BEGIN = 13, // c = bytes, name = what
+    GGML_HPROF_GET_TENSOR_END   = 14, // name = what
+    GGML_HPROF_SYNC_BEGIN       = 15, // llama_context::synchronize
+    GGML_HPROF_SYNC_END         = 16,
+    GGML_HPROF_HEX_SEND         = 17, // a = batch seq, b = n_ops, c = request bytes, name = session
+    GGML_HPROF_HEX_RECV         = 18, // a = batch seq, b = n_ops, c = DSP usec, d = host usec since push, name = session
+    GGML_HPROF_HEX_WAIT_BEGIN   = 19, // flush_pending entry, a = batches pending, name = session
+    GGML_HPROF_HEX_WAIT_END     = 20, // a = batches received
+    GGML_HPROF_NODE_DONE        = 21, // a = split, b = index of the computed node within the split, name = backend (small splits only)
+    GGML_HPROF_SYS              = 22, // a = sample index, b = value, c = cpu of the sampling thread, name = key ("thermal:<type>", "cpufreq:policyN")
+};
+
+// 1 when enabled. Cheap after the first call.
+GGML_HPROF_API int  ggml_hprof_enabled(void);
+
+// Record an event with the current ggml_time_us() timestamp. name may be NULL.
+GGML_HPROF_API void ggml_hprof_ev(int kind, uint64_t a, uint64_t b, uint64_t c, uint64_t d, const char * name);
+
+// Append a formatted text line to the buffer (used for the hexagon per-op profile lines).
+GGML_HPROF_API void ggml_hprof_logf(const char * fmt, ...);
+
+// Append len bytes of preformatted text (same buffering rules as ggml_hprof_logf; used for the
+// compact mode-3 trace lines, which are built without printf).
+GGML_HPROF_API void ggml_hprof_puts(const char * s, size_t len);
+
+// Print everything buffered so far to stderr and clear the buffer.
+GGML_HPROF_API void ggml_hprof_dump(void);
+
+// Maximum number of nodes for which SPLIT_NODE events are emitted.
+GGML_HPROF_API int  ggml_hprof_max_split_nodes(void);
+
+// Scheduler: the split that is about to be computed (enables NODE_DONE for small splits). backend may be NULL.
+GGML_HPROF_API void ggml_hprof_set_split(int split_id, int n_nodes, const char * backend);
+
+// Backend hook (CPU abort callback): one computed node of the current split finished.
+GGML_HPROF_API void ggml_hprof_node_done(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+// Convenience macros: no-ops when disabled, one branch otherwise.
+#define GGML_HPROF_EV(kind, a, b, c, d, name) \
+    do { if (ggml_hprof_enabled()) { ggml_hprof_ev((kind), (uint64_t) (a), (uint64_t) (b), (uint64_t) (c), (uint64_t) (d), (name)); } } while (0)
+
+#define GGML_HPROF_MARK(kind) GGML_HPROF_EV((kind), 0, 0, 0, 0, NULL)
