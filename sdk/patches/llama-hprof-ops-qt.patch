+static int g_hprof_in_decode = 0;
+
+// hprof: the CPU backend calls its abort callback after every computed node (thread 0, before the
+// barrier); wrapping the user's callback gives per-node timestamps for the small CPU splits (islands)
+static bool (*g_hprof_user_abort_cb)(void *) = nullptr;
