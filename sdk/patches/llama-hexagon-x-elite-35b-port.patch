+                    !htp_conv_ranges_overlap(sn, old) && !htp_conv_ranges_overlap(sn, f.next)) {
+                    f.silu  = sn;
+                    f.y_out = sn;
+                    folded[k] = 1;
+                    break;
+                }
+            }
+        }
+
+        uint32_t n_hvx = std::min<uint32_t>(sess_n_hvx, (uint32_t) (C / HTP_SSM_DIRECT_SLICE));
+        if (T > 1) {   // chunked prefill kernel: 32-aligned channel range per thread
+            while (n_hvx > 1 && (C % (32 * n_hvx)) != 0) n_hvx--;
+        }
