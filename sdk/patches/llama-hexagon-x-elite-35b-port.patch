+static inline dma_addr_t gdn_state_in_addr(const struct htp_tensor * state,
+                                           const struct htp_tensor * state_idx,
+                                           const struct htp_gdn_kernel_params * kp,
+                                           uint32_t piv3, uint32_t piv1, uint32_t S_v) {
