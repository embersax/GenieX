+// Per-thread HVX scratch for the fused gates (static: the toolchain does not honour aligned() on stack arrays).
+static float gdn_gate_scratch[HTP_MAX_NTHREADS + 1][8][32] __attribute__((aligned(128)));
+
+// ADD(alpha, dt) -> SOFTPLUS -> MUL(A) and SIGMOID(beta_raw), with the routines the separate ops use.
+static void gdn_compute_gates(const struct htp_ops_context * octx, unsigned int ith, uint32_t H, float ** g_out_p, float ** b_out_p) {
+    float (*sc)[32] = gdn_gate_scratch[ith];
+    float * a = sc[0], * d = sc[1], * aa = sc[2], * br = sc[3], * t1 = sc[4], * t2 = sc[5];
+    float * g_out = sc[6], * b_out = sc[7];
+    *g_out_p = g_out; *b_out_p = b_out;
+    memset(sc, 0, 8 * 32 * sizeof(float));
+    for (uint32_t h = 0; h < H; h++) {
+        a[h]  = gdn_gate_elem(octx->src[3], h);
+        br[h] = gdn_gate_elem(octx->src[4], h);
+        d[h]  = gdn_gate_elem(octx->src[7], h);
+        aa[h] = gdn_gate_elem(octx->src[8], h);
+    }
+    hvx_add_f32_aaa((uint8_t *) t1, (const uint8_t *) a, (const uint8_t *) d, H);
+    gdn_softplus_f32_aa((uint8_t *) t2, (const uint8_t *) t1, H);
+    hvx_mul_f32_aaa((uint8_t *) g_out, (const uint8_t *) t2, (const uint8_t *) aa, H);
+    hvx_sigmoid_f32_aa((uint8_t *) b_out, (const uint8_t *) br, H);
+}
