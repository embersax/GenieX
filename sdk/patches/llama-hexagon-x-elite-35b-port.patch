diff --git a/ggml/src/ggml-hexagon/htp/ssm-conv.h b/ggml/src/ggml-hexagon/htp/ssm-conv.h
index 7c3f3041f..71c814eac 100644
--- a/ggml/src/ggml-hexagon/htp/ssm-conv.h
+++ b/ggml/src/ggml-hexagon/htp/ssm-conv.h
@@ -8,6 +8,31 @@
 #include "htp-ops.h"
 #include "htp-vtcm.h"
 
+// SSM_CONV_DIRECT (decode): src[0] = x [C, T], src[1] = old state [3, C], src[2] = weight [4, C];
+// dsts[0] = next state [3C, 1] (the recurrent-cache slot), dsts[1] = y [C, T] (SiLU applied when kparams->silu).
+// The host selects it by giving the op three inputs and two outputs; see htp_conv_direct_* in ggml-hexagon.cpp.
+enum { HTP_SSM_DIRECT_SLICE = 128, HTP_SSM_DIRECT_MAX_T = 1024 };   // MAX_T = KDA_MAX_T of the prefill4 kernel
+
+static inline uint32_t htp_ssm_direct_vtcm_bytes_per_thread(uint32_t tokens) {
+    return (2 * tokens + 3 + 4 + 3) * HTP_SSM_DIRECT_SLICE * sizeof(float);
+}
+
+// Prefill (T > 1, x-elite port P2): each HVX thread owns channels/n_hvx channels and streams the tokens in chunks of
+// HTP_SSM_DIRECT_TC rows (wide 2D DMAs: one row = its whole channel range), double-buffered in and out, with the
+// three history rows kept in front of every chunk so the conv is a 4-tap FIR over VTCM rows.
+enum { HTP_SSM_DIRECT_TC = 32 };
+
+static inline uint32_t htp_ssm_direct_chunk_tokens(uint32_t tokens) {
+    return tokens < HTP_SSM_DIRECT_TC ? tokens : HTP_SSM_DIRECT_TC;
+}
+
+// n_hvx threads must split the channels into 32-aligned ranges: channels % (32 * n_hvx) == 0
+static inline uint32_t htp_ssm_direct_vtcm_bytes_per_thread_prefill(uint32_t tokens, uint32_t channels, uint32_t n_hvx) {
+    const uint32_t cth = channels / n_hvx;
+    const uint32_t tc  = htp_ssm_direct_chunk_tokens(tokens);
+    return (2 * (3 + tc) + 2 * tc + 4 + 3) * cth * sizeof(float);
+}
