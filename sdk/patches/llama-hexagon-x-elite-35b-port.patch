+/* SPDX-License-Identifier: MIT
+ * Qf32 convolution and four-tap weight deinterleave adapted from llama.cpp,
+ * commit 94256114c229674ef96e76eb2dea596e65b43818, ggml-hexagon/htp/ssm-conv.c.
+ * See LICENSE.llama.cpp. Token-major carry follows the verified direct prototype.
+ */
+#include "kernel.h"
+#include <hexagon_types.h>
+#include <hexagon_protos.h>
+#include <hvx_hexagon_protos.h>
+
+void prefill4_hvx(const float *restrict x, const float *restrict old,
+                 const float *restrict weight, float *restrict y, float *restrict next,
+                 unsigned tokens, unsigned channels, unsigned tree_order) {
+    union { HVX_Vector vec[3]; float f[3][32]; } history[KDA_MAX_C/32];
+    HVX_Vector wt[KDA_MAX_C/32][4];
+    kda_phase_begin(KDA_PREP);
+    for (unsigned c = 0; c < channels; c += 32) {
+        const unsigned block = c / 32;
+        const HVX_Vector *w = (const HVX_Vector *)(weight + 4*c);
+        HVX_VectorPair p01 = Q6_W_vdeal_VVR(w[1], w[0], -4);
+        HVX_VectorPair p23 = Q6_W_vdeal_VVR(w[3], w[2], -4);
+        HVX_VectorPair p02 = Q6_W_vdeal_VVR(Q6_V_lo_W(p23), Q6_V_lo_W(p01), -4);
+        HVX_VectorPair p13 = Q6_W_vdeal_VVR(Q6_V_hi_W(p23), Q6_V_hi_W(p01), -4);
+        wt[block][0] = Q6_V_lo_W(p02);
+        wt[block][1] = Q6_V_lo_W(p13);
+        wt[block][2] = Q6_V_hi_W(p02);
+        wt[block][3] = Q6_V_hi_W(p13);
+        for (unsigned j = 0; j < 32; ++j) {
+            history[block].f[0][j] = old[3*(c+j)];
+            history[block].f[1][j] = old[3*(c+j)+1];
+            history[block].f[2][j] = old[3*(c+j)+2];
+        }
+    }
+    kda_phase_end(KDA_PREP);
+    kda_phase_begin(KDA_CONV);
+    for (unsigned c = 0; c < channels; c += 32) {
+        const unsigned block = c / 32;
+        HVX_Vector h0 = history[block].vec[0], h1 = history[block].vec[1], h2 = history[block].vec[2];
+        const HVX_Vector w0 = wt[block][0], w1 = wt[block][1], w2 = wt[block][2], w3 = wt[block][3];
+        #pragma clang loop unroll_count(4)
+        for (unsigned t = 0; t < tokens; ++t) {
+            HVX_Vector x3 = *(const HVX_Vector *)(x + t*channels + c);
+            HVX_Vector sum;
+            if (tree_order) {
+                // stock d_conv == 4 decode kernel (ssm-conv.c): (h0w0 + h1w1) + (h2w2 + x3w3)
+                HVX_Vector a = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(h0, w0), Q6_Vqf32_vmpy_VsfVsf(h1, w1));
+                HVX_Vector b = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(h2, w2), Q6_Vqf32_vmpy_VsfVsf(x3, w3));
+                sum = Q6_Vqf32_vadd_Vqf32Vqf32(a, b);
+            } else {
+                // stock prefill kernel: acc = 0; acc += x_j * w_j for j = 0..3
+                sum = Q6_V_vzero();   // same bits as the stock zero start (sf 0.0)
+                sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(h0, w0));
+                sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(h1, w1));
+                sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(h2, w2));
+                sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(x3, w3));
+            }
+            *(HVX_Vector *)(y + t*channels + c) = Q6_Vsf_equals_Vqf32(sum);
+            h0 = h1; h1 = h2; h2 = x3;
+        }
+    }
+    kda_phase_end(KDA_CONV);
+    kda_phase_begin(KDA_STATE);
+    for (unsigned c = 0; c < channels; c += 32) {
+        const unsigned block = c / 32;
+        const float *last = x + (tokens-1)*channels + c;
+        HVX_Vector r2 = *(const HVX_Vector *)last;
+        HVX_Vector r1 = tokens >= 2 ? *(const HVX_Vector *)(last - channels)
+                                    : history[block].vec[2];
+        HVX_Vector r0 = tokens >= 3 ? *(const HVX_Vector *)(last - 2*channels)
+                                    : history[block].vec[tokens];
+
+        // Form eight (r0, r1, r2, pad) quads in each vector.
+        HVX_VectorPair ab = Q6_W_vshuff_VVR(r1, r0, -4);
+        HVX_VectorPair cc = Q6_W_vshuff_VVR(r2, r2, -4);
+        HVX_VectorPair lo = Q6_W_vshuff_VVR(Q6_V_lo_W(cc), Q6_V_lo_W(ab), -8);
+        HVX_VectorPair hi = Q6_W_vshuff_VVR(Q6_V_hi_W(cc), Q6_V_hi_W(ab), -8);
+        HVX_Vector q0 = Q6_V_lo_W(lo), q1 = Q6_V_hi_W(lo);
+        HVX_Vector q2 = Q6_V_lo_W(hi), q3 = Q6_V_hi_W(hi);
+
+        // Reverse delta compacts the 24 live words into the low 96 bytes.
+        // Tracing output word i backwards through strides 16,8,4,2,1
+        // routes it to input word i+i/3. Each byte of a word follows that route.
+        static const HVX_Vector compact = {
+            0x00000000, 0x00000000, 0x00000000, 0x10101010,
+            0x04040404, 0x0c0c0c0c, 0x20202020, 0x2c2c2c2c,
+            0x08080808, 0x10101010, 0x18181818, 0x18181818,
+            0x44444444, 0x44444444, 0x58585858, 0x54545454,
+            0x10101010, 0x10101010, 0x20202020, 0x20202020,
+            0x34343434, 0x3c3c3c3c, 0x30303030, 0x2c2c2c2c,
+            0x08080808, 0x00000000, 0x08080808, 0x08080808,
+            0x34343434, 0x24242424, 0x28282828, 0x24242424
+        };
+        HVX_Vector a = Q6_V_vrdelta_VV(q0, compact);
+        HVX_Vector b = Q6_V_vrdelta_VV(q1, compact);
+        HVX_Vector c2 = Q6_V_vrdelta_VV(q2, compact);
+        HVX_Vector d = Q6_V_vrdelta_VV(q3, compact);
+
+        // Put the low 96 bytes of the left chunk at the high end, then
+        // splice 96+32, 64+64 and 32+96 bytes into three aligned stores.
+        HVX_Vector *dst = (HVX_Vector *)(next + 3*c);
+        dst[0] = Q6_V_valign_VVR(b, Q6_V_vror_VR(a, 96), 32);
+        dst[1] = Q6_V_valign_VVR(c2, Q6_V_vror_VR(b, 96), 64);
+        dst[2] = Q6_V_valign_VVR(d, Q6_V_vror_VR(c2, 96), 96);
+    }
+    kda_phase_end(KDA_STATE);
+}
diff --git a/ggml/src/ggml-hexagon/htp/qedge_prefill4/kernel.h b/ggml/src/ggml-hexagon/htp/qedge_prefill4/kernel.h
new file mode 100644
index 000000000..e23421e56
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/qedge_prefill4/kernel.h
@@ -0,0 +1,27 @@
+#ifndef HEXAGON_PREFILL4_H
+#define HEXAGON_PREFILL4_H
+
+#include <stdint.h>
+
+// One prepared token-major tile (row stride = channels); all buffers are disjoint
+// and 128B aligned. 1 <= tokens <= 1024; channels is 32, 64, 96 or 128.
+// old and next are [channel][3]; weight is [channel][4]; x and y are
+// [token][channel]. Order taps old0, old1, old2, x0 at the first token.
+enum { KDA_MAX_T = 1024, KDA_MAX_C = 128, KDA_STAGES = 3 };
+enum { KDA_PREP, KDA_CONV, KDA_STATE };
+
+void prefill4_hvx(const float *restrict x, const float *restrict old,
+                 const float *restrict weight, float *restrict y, float *restrict next,
+                 unsigned tokens, unsigned channels, unsigned tree_order);
+
+// Phase cycles use separate unscored binaries. The latency score measures the
+// full call with these hooks compiled out; phases are contiguous, once each.
+#ifdef KDA_PHASE_PROFILE
+void kda_phase_begin(unsigned);
+void kda_phase_end(unsigned);
+#else
+#define kda_phase_begin(i) ((void)(i))
+#define kda_phase_end(i) ((void)(i))
+#endif
+
+#endif
diff --git a/ggml/src/ggml-hexagon/htp/ssm-conv.c b/ggml/src/ggml-hexagon/htp/ssm-conv.c
index d75304fef..b3d49ceeb 100644
--- a/ggml/src/ggml-hexagon/htp/ssm-conv.c
+++ b/ggml/src/ggml-hexagon/htp/ssm-conv.c
@@ -20,6 +20,8 @@
 #include "htp-tensor.h"
 #include "hvx-utils.h"
 #include "ssm-conv.h"
+#include "hvx-arith.h"
+#include "hvx-sigmoid.h"
 
 struct htp_ssm_conv_context {
     struct htp_ops_context *                  octx;
@@ -634,7 +636,297 @@ int op_ssm_conv_f32(struct htp_ops_context * octx) {
     return HTP_STATUS_OK;
 }
 
+// ---- SSM_CONV_DIRECT: one-token conv straight from the recurrent-cache state, state write-back and optional SiLU ----
+#include "qedge_prefill4/candidate.c"
+
+struct ssm_direct_task {
+    struct htp_ops_context * octx;
+    uint32_t channels;
+    uint32_t tokens;
+    uint32_t silu;
+    uint32_t per_thread_bytes;
+    bool     failed[HTP_OP_MAX_NTHREADS];
+};
+
+static bool ssm_direct_tensor_ok(const struct htp_context * ctx, const struct htp_tensor * t, uint32_t cols, uint32_t rows) {
+    const uint64_t bytes = (uint64_t) cols * rows * sizeof(float);
+    if (!t || t->type != HTP_TYPE_F32 || (t->flags & (HTP_TENSOR_TILED | HTP_TENSOR_FENCE)) ||
+        t->ne[0] != cols || t->ne[1] != rows || t->ne[2] != 1 || t->ne[3] != 1 ||
+        !htp_tensor_is_contiguous(t, sizeof(float)) || t->size != bytes ||
+        !t->data || (t->data & 127u) || t->data > UINT32_MAX - bytes) {
+        return false;
+    }
+    for (uint32_t i = 0; i < HTP_MAX_MMAPS; ++i) {
+        const struct htp_mmap * m = &ctx->mmap[i];
+        if (!(m->flags & HTP_BUF_EXTENDED) && m->size >= bytes &&
+            t->data >= m->base && t->data - m->base <= m->size - bytes) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void ssm_direct_worker(const htp_thread_t * th, unsigned int nth, unsigned int ith, void * data) {
+    struct ssm_direct_task * task = data;
+    struct htp_ops_context * octx = task->octx;
+    const uint32_t tokens = task->tokens;
+    const uint32_t tile   = HTP_SSM_DIRECT_SLICE;
+    const uint32_t row    = tile * sizeof(float);
+    float * x      = (float *) (octx->ctx->vtcm_base + (size_t) ith * task->per_thread_bytes);
+    float * y      = x + tokens * tile;
+    float * old    = y + tokens * tile;
+    float * weight = old + 3 * tile;
+    float * next   = weight + 4 * tile;
+    dma_queue * q = th->dma_q;
+    struct htp_thread_trace * tr = th->trace;
+
+    for (uint32_t c = ith * tile; c < task->channels; c += nth * tile) {
+        const uint32_t off = c * sizeof(float);
+        if (!dma_queue_push(q, dma_make_data(old, octx->src[1]->data + 3 * off), 3 * row, 3 * row, 3 * row, 1) ||
+            !dma_queue_push(q, dma_make_data(weight, octx->src[2]->data + 4 * off), 4 * row, 4 * row, 4 * row, 1) ||
+            !dma_queue_push(q, dma_make_data(x, octx->src[0]->data + off), row, octx->src[0]->nb[1], row, tokens)) {
+            goto dma_failed;
+        }
+        dma_queue_flush(q);
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) c);
+        prefill4_hvx(x, old, weight, y, next, tokens, tile, 1 /* tree order: both stock paths that run for d_conv == 4 (T == 1 verified, T > 1 the prefill fast path) */);
+        if (task->silu) {
+            // same primitive as the stock fused SSM_CONV+SILU kernel (hvx_ssm_conv_silu_vtcm), so y is bit-identical
+            HVX_Vector * restrict vy = (HVX_Vector *) y;
+            for (uint32_t i = 0; i < (tokens * tile) / 32; ++i) {
+                vy[i] = hvx_vec_silu_f32(vy[i]);
+            }
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) c);
+        if (!dma_queue_push(q, dma_make_data(octx->dsts[1]->data + off, y), octx->dsts[1]->nb[1], row, row, tokens) ||
+            !dma_queue_push(q, dma_make_data(octx->dsts[0]->data + 3 * off, next), 3 * row, 3 * row, 3 * row, 1)) {
+            goto dma_failed;
+        }
+        dma_queue_flush(q);
+    }
+    return;
+dma_failed:
+    dma_queue_flush(q);
+    task->failed[ith] = true;
+}
+
+
+// ---- SSM_CONV_DIRECT prefill (T > 1): chunked, wide-row DMAs, 4-tap FIR over VTCM rows (x-elite port P2) ----
+// Same arithmetic as prefill4_hvx (tree order (h0w0 + h1w1) + (h2w2 + x3w3) in qf32), so y and the state are
+// bit-identical; only the data movement changes: the thread's whole channel range is one DMA row.
+static inline void ssm_direct_prep_weights(const float * restrict wraw, HVX_Vector * restrict wt, uint32_t cth) {
+    for (uint32_t c = 0; c < cth; c += 32) {
+        const HVX_Vector * w = (const HVX_Vector *) (wraw + 4 * c);
+        HVX_VectorPair p01 = Q6_W_vdeal_VVR(w[1], w[0], -4);
+        HVX_VectorPair p23 = Q6_W_vdeal_VVR(w[3], w[2], -4);
+        HVX_VectorPair p02 = Q6_W_vdeal_VVR(Q6_V_lo_W(p23), Q6_V_lo_W(p01), -4);
+        HVX_VectorPair p13 = Q6_W_vdeal_VVR(Q6_V_hi_W(p23), Q6_V_hi_W(p01), -4);
+        HVX_Vector * o = wt + (c / 32) * 4;
+        o[0] = Q6_V_lo_W(p02);
+        o[1] = Q6_V_lo_W(p13);
+        o[2] = Q6_V_hi_W(p02);
+        o[3] = Q6_V_hi_W(p13);
+    }
+}
+
+// old[3c + k] (channel-major) -> three history rows [k][c]
+static inline void ssm_direct_prep_history(const float * restrict old, float * restrict rows, uint32_t cth) {
+    for (uint32_t c = 0; c < cth; ++c) {
+        rows[c]           = old[3 * c];
+        rows[cth + c]     = old[3 * c + 1];
+        rows[2 * cth + c] = old[3 * c + 2];
+    }
+}
+
+// y[t] = (x[t-3] w0 + x[t-2] w1) + (x[t-1] w2 + x[t] w3) over the unified buffer xu (3 history rows + tk rows)
+static void ssm_direct_fir(const float * restrict xu, const HVX_Vector * restrict wt, float * restrict y, uint32_t tk, uint32_t cth) {
+    const uint32_t nblk = cth / 32;
+    for (uint32_t t = 0; t < tk; ++t) {
+        const HVX_Vector * r0 = (const HVX_Vector *) (xu + (size_t) t * cth);
+        const HVX_Vector * r1 = (const HVX_Vector *) (xu + (size_t) (t + 1) * cth);
+        const HVX_Vector * r2 = (const HVX_Vector *) (xu + (size_t) (t + 2) * cth);
+        const HVX_Vector * r3 = (const HVX_Vector *) (xu + (size_t) (t + 3) * cth);
+        HVX_Vector * yo = (HVX_Vector *) (y + (size_t) t * cth);
+        #pragma clang loop unroll_count(4)
+        for (uint32_t b = 0; b < nblk; ++b) {
+            const HVX_Vector * w = wt + b * 4;
+            HVX_Vector a  = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(r0[b], w[0]), Q6_Vqf32_vmpy_VsfVsf(r1[b], w[1]));
+            HVX_Vector bb = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(r2[b], w[2]), Q6_Vqf32_vmpy_VsfVsf(r3[b], w[3]));
+            yo[b] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(a, bb));
+        }
+    }
+}
+
+// next[3c + k] = the last three x rows of the channel range (same packing as prefill4_hvx's state phase)
+static void ssm_direct_pack_state(const float * restrict r0s, const float * restrict r1s, const float * restrict r2s, float * restrict next, uint32_t cth) {
+    static const HVX_Vector compact = {
+        0x00000000, 0x00000000, 0x00000000, 0x10101010,
+        0x04040404, 0x0c0c0c0c, 0x20202020, 0x2c2c2c2c,
+        0x08080808, 0x10101010, 0x18181818, 0x18181818,
+        0x44444444, 0x44444444, 0x58585858, 0x54545454,
+        0x10101010, 0x10101010, 0x20202020, 0x20202020,
+        0x34343434, 0x3c3c3c3c, 0x30303030, 0x2c2c2c2c,
+        0x08080808, 0x00000000, 0x08080808, 0x08080808,
+        0x34343434, 0x24242424, 0x28282828, 0x24242424
+    };
+    for (uint32_t c = 0; c < cth; c += 32) {
+        HVX_Vector r0 = *(const HVX_Vector *) (r0s + c);
+        HVX_Vector r1 = *(const HVX_Vector *) (r1s + c);
+        HVX_Vector r2 = *(const HVX_Vector *) (r2s + c);
+        HVX_VectorPair ab = Q6_W_vshuff_VVR(r1, r0, -4);
+        HVX_VectorPair cc = Q6_W_vshuff_VVR(r2, r2, -4);
+        HVX_VectorPair lo = Q6_W_vshuff_VVR(Q6_V_lo_W(cc), Q6_V_lo_W(ab), -8);
+        HVX_VectorPair hi = Q6_W_vshuff_VVR(Q6_V_hi_W(cc), Q6_V_hi_W(ab), -8);
+        HVX_Vector a  = Q6_V_vrdelta_VV(Q6_V_lo_W(lo), compact);
+        HVX_Vector b  = Q6_V_vrdelta_VV(Q6_V_hi_W(lo), compact);
+        HVX_Vector c2 = Q6_V_vrdelta_VV(Q6_V_lo_W(hi), compact);
+        HVX_Vector d  = Q6_V_vrdelta_VV(Q6_V_hi_W(hi), compact);
+        HVX_Vector * dst = (HVX_Vector *) (next + 3 * c);
+        dst[0] = Q6_V_valign_VVR(b, Q6_V_vror_VR(a, 96), 32);
+        dst[1] = Q6_V_valign_VVR(c2, Q6_V_vror_VR(b, 96), 64);
+        dst[2] = Q6_V_valign_VVR(d, Q6_V_vror_VR(c2, 96), 96);
+    }
+}
+
+static void ssm_direct_worker_chunked(const htp_thread_t * th, unsigned int nth, unsigned int ith, void * data) {
+    struct ssm_direct_task * task = data;
+    struct htp_ops_context * octx = task->octx;
+    const uint32_t tokens = task->tokens;
+    const uint32_t cth    = task->channels / nth;          // channels of this thread (32-aligned, checked by the op)
+    const uint32_t c0     = ith * cth;
+    const uint32_t tc     = htp_ssm_direct_chunk_tokens(tokens);
+    const uint32_t nchunk = (tokens + tc - 1) / tc;
+    const size_t   row    = (size_t) cth * sizeof(float);
+
+    float * base  = (float *) (octx->ctx->vtcm_base + (size_t) ith * task->per_thread_bytes);
+    float * xb[2] = { base, base + (size_t) (3 + tc) * cth };
+    float * yb[2] = { xb[1] + (size_t) (3 + tc) * cth, xb[1] + (size_t) (3 + tc) * cth + (size_t) tc * cth };
+    HVX_Vector * wt = (HVX_Vector *) (yb[1] + (size_t) tc * cth);           // 4 * cth floats
+    float * next  = (float *) (wt + (cth / 32) * 4);                          // 3 * cth floats
+    float * oldraw = yb[0];                                                   // temp (3 * cth floats, before W0)
+    float * wraw   = yb[1];                                                   // temp (4 * cth floats, before W1)
+    dma_queue * q = th->dma_q;
+    struct htp_thread_trace * tr = th->trace;
+
+    const dma_addr_t x_ddr = octx->src[0]->data + (dma_addr_t) c0 * sizeof(float);
+    const dma_addr_t y_ddr = octx->dsts[1]->data + (dma_addr_t) c0 * sizeof(float);
+    const size_t x_stride  = octx->src[0]->nb[1];
+    const size_t y_stride  = octx->dsts[1]->nb[1];
+
+    #define SSM_CHUNK_TOKENS(k) (((k) + 1 < nchunk) ? tc : (tokens - (k) * tc))
+    #define SSM_PUSH_FETCH(k) \
+        dma_queue_push(q, dma_make_data(xb[(k) & 1] + 3 * cth, x_ddr + (dma_addr_t) (k) * tc * x_stride), row, x_stride, row, SSM_CHUNK_TOKENS(k))
+    #define SSM_PUSH_WRITE(k) \
+        dma_queue_push(q, dma_make_data(y_ddr + (dma_addr_t) (k) * tc * y_stride, yb[(k) & 1]), y_stride, row, row, SSM_CHUNK_TOKENS(k))
+
+    if (!dma_queue_push(q, dma_make_data(oldraw, octx->src[1]->data + (dma_addr_t) 3 * c0 * sizeof(float)), 3 * row, 3 * row, 3 * row, 1) ||
+        !dma_queue_push(q, dma_make_data(wraw,   octx->src[2]->data + (dma_addr_t) 4 * c0 * sizeof(float)), 4 * row, 4 * row, 4 * row, 1) ||
+        !SSM_PUSH_FETCH(0) || (nchunk > 1 && !SSM_PUSH_FETCH(1))) {
+        goto dma_failed;
+    }
+    dma_queue_pop(q);   // old state
+    dma_queue_pop(q);   // weights
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_W_PREP, (uint16_t) ith);
+    ssm_direct_prep_history(oldraw, xb[0], cth);
+    ssm_direct_prep_weights(wraw, wt, cth);
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_W_PREP, (uint16_t) ith);
+
+    for (uint32_t k = 0; k < nchunk; ++k) {
+        const uint32_t tk = SSM_CHUNK_TOKENS(k);
+        float * xu = xb[k & 1];
+        float * yo = yb[k & 1];
+        if (k >= 2) dma_queue_pop(q);   // W(k-2): yb[k & 1] is free again
+        dma_queue_pop(q);               // F(k)
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) k);
+        ssm_direct_fir(xu, wt, yo, tk, cth);
+        if (task->silu) {
+            HVX_Vector * restrict vy = (HVX_Vector *) yo;
+            for (uint32_t i = 0; i < (tk * cth) / 32; ++i) {
+                vy[i] = hvx_vec_silu_f32(vy[i]);
+            }
+        }
+        if (k + 1 < nchunk) {
+            // history for the next chunk = the last three rows of this one (unified index tk .. tk + 2)
+            hvx_copy_f32_aa((uint8_t *) xb[(k + 1) & 1], (const uint8_t *) (xu + (size_t) tk * cth), 3 * cth);
+        } else {
+            ssm_direct_pack_state(xu + (size_t) tk * cth, xu + (size_t) (tk + 1) * cth, xu + (size_t) (tk + 2) * cth, next, cth);
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) k);
+        if (!SSM_PUSH_WRITE(k) || (k + 2 < nchunk && !SSM_PUSH_FETCH(k + 2))) {
+            goto dma_failed;
+        }
+    }
+    if (!dma_queue_push(q, dma_make_data(octx->dsts[0]->data + (dma_addr_t) 3 * c0 * sizeof(float), next), 3 * row, 3 * row, 3 * row, 1)) {
+        goto dma_failed;
+    }
+    dma_queue_flush(q);
+    #undef SSM_CHUNK_TOKENS
+    #undef SSM_PUSH_FETCH
+    #undef SSM_PUSH_WRITE
+    return;
+dma_failed:
+    dma_queue_flush(q);
+    task->failed[ith] = true;
+}
+
+static int op_ssm_direct(struct htp_ops_context * octx) {
+    const struct htp_ssm_conv_kernel_params * kp = (const struct htp_ssm_conv_kernel_params *) octx->kernel_params;
+    const uint32_t tokens   = kp->n_t;
+    const uint32_t channels = kp->d_inner;
+    struct htp_context * ctx = octx->ctx;
+    if (tokens == 0 || tokens > HTP_SSM_DIRECT_MAX_T || channels == 0 || (channels % HTP_SSM_DIRECT_SLICE) != 0 || ctx->mdev.count > 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (!htp_ops_context_set_n_hvx(octx, kp->n_hvx)) {
+        return HTP_STATUS_CONV_NHVX;
+    }
+    const uint32_t n_hvx = octx->n_hvx;
+    if (tokens > 1 && (n_hvx == 0 || (channels % (32 * n_hvx)) != 0)) {
+        return HTP_STATUS_CONV_NHVX;
+    }
+    const uint32_t per_thread_bytes = (tokens > 1) ? htp_ssm_direct_vtcm_bytes_per_thread_prefill(tokens, channels, n_hvx)
+                                                   : htp_ssm_direct_vtcm_bytes_per_thread(tokens);
+    const uint64_t bytes = (uint64_t) per_thread_bytes * n_hvx;
+    if (n_hvx == 0 || n_hvx > HTP_OP_MAX_NTHREADS || kp->vtcm_size != bytes) {
+        return HTP_STATUS_CONV_VTCM;
+    }
+    if (ctx->vtcm_size < bytes || !ctx->vtcm_base || ((uintptr_t) ctx->vtcm_base & 127u)) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    const struct htp_tensor * ts[] = { octx->src[0], octx->src[1], octx->src[2], octx->dsts[0], octx->dsts[1] };
+    if (!ssm_direct_tensor_ok(ctx, ts[0], channels, tokens)) return HTP_STATUS_CONV_T0;
+    if (!ssm_direct_tensor_ok(ctx, ts[1], 3, channels))      return HTP_STATUS_CONV_T1;
+    if (!ssm_direct_tensor_ok(ctx, ts[2], 4, channels))      return HTP_STATUS_CONV_T2;
+    if (!ssm_direct_tensor_ok(ctx, ts[3], 3 * channels, 1))  return HTP_STATUS_CONV_T3;
+    if (!ssm_direct_tensor_ok(ctx, ts[4], channels, tokens)) return HTP_STATUS_CONV_T4;
+    if ((ts[3]->flags | ts[4]->flags) & HTP_TENSOR_WEIGHT)   return HTP_STATUS_CONV_WEIGHT;
+    // outputs must not overlap inputs, except y exactly aliasing x: ggml-alloc reuses x's bytes for the conv
+    // output, and each slice reads its x block into VTCM before its y block is written (slices are disjoint).
+    for (int i = 3; i < 5; ++i) {
+        for (int j = 0; j < i; ++j) {
+            if (i == 4 && j == 0 && ts[4]->data == ts[0]->data && ts[4]->size == ts[0]->size) continue;
+            if (ts[i]->data < ts[j]->data + ts[j]->size && ts[j]->data < ts[i]->data + ts[i]->size) {
+                return HTP_STATUS_CONV_OVERLAP;
+            }
+        }
+    }
+    struct ssm_direct_task task = { .octx = octx, .channels = channels, .tokens = tokens, .silu = kp->silu,
+                                    .per_thread_bytes = per_thread_bytes };
+    work_queue_run(ctx->hvx_queue, (tokens > 1) ? ssm_direct_worker_chunked : ssm_direct_worker, &task, n_hvx);
+    for (uint32_t i = 0; i < n_hvx; ++i) {
+        if (task.failed[i]) return HTP_STATUS_INTERNAL_ERR;
+    }
+    FARF(HIGH, "ssm-conv-direct: C %u T %u n_hvx %u silu %u\n", channels, tokens, n_hvx, kp->silu);
+    return HTP_STATUS_OK;
+}
