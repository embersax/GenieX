+#ifndef HEXAGON_PREFILL4_H
+#define HEXAGON_PREFILL4_H
+
+#include <stdint.h>
+
+// One prepared token-major tile (row stride = channels); all buffers are disjoint
+// and 128B aligned. 1 <= tokens <= 1024; channels is 32, 64, 96 or 128.
+// old and next are [channel][3]; weight is [channel][4]; x and y are
+// [token][channel]. Order taps old0, old1, old2, x0 at the first token.
+enum { KDA_MAX_T = 1024, KDA_MAX_C = 128, KDA_STAGES = 3 };
+enum { KDA_PREP, KDA_CONV, KDA_STATE };
+
+void prefill4_hvx(const float *restrict x, const float *restrict old,
+                 const float *restrict weight, float *restrict y, float *restrict next,
+                 unsigned tokens, unsigned channels);
+
+// Phase cycles use separate unscored binaries. The latency score measures the
+// full call with these hooks compiled out; phases are contiguous, once each.
+#ifdef KDA_PHASE_PROFILE
+void kda_phase_begin(unsigned);
+void kda_phase_end(unsigned);
+#else
+#define kda_phase_begin(i) ((void)(i))
+#define kda_phase_end(i) ((void)(i))
+#endif
+
+#endif
