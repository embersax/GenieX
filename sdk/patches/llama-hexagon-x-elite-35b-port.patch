+// x-elite port B3: q4_0 tile nibble layout. Vector i (bytes 128i..128i+127), byte[4*row + j] = k 8i+j (low nibble)
+// | k 8i+4+j (high nibble), so the DSP kernels unpack with a mask and a shift instead of a byte transpose.
+static inline void transpose_nibbles_to_tile_q4v2(uint8_t * tile_dst, const uint8_t tile_quants[32][32]) {
+    for (int i = 0; i < 4; i++) {
+        for (int row = 0; row < 32; row++) {
+            for (int j = 0; j < 4; j++) {
+                tile_dst[i * 128 + row * 4 + j] = (uint8_t) (tile_quants[row][8 * i + j] | (tile_quants[row][8 * i + 4 + j] << 4));
+            }
+        }
+    }
+}
+
+static inline void transpose_tile_to_nibbles_q4v2(uint8_t tile_quants[32][32], const uint8_t * tile_src) {
+    for (int i = 0; i < 4; i++) {
+        for (int row = 0; row < 32; row++) {
+            for (int j = 0; j < 4; j++) {
+                const uint8_t val = tile_src[i * 128 + row * 4 + j];
+                tile_quants[row][8 * i + j]     = val & 0x0F;
+                tile_quants[row][8 * i + 4 + j] = val >> 4;
+            }
+        }
+    }
+}
