+// ---- decode folds (HTP_GDN_FLAG_*) ----
+static inline dma_addr_t gdn_state_in_addr(const struct htp_tensor * state,
+                                           const struct htp_tensor * state_idx,
+                                           const struct htp_gdn_kernel_params * kp,
+                                           uint32_t piv3, uint32_t piv1, uint32_t S_v) {
+    if (kp->flags & HTP_GDN_FLAG_STATE_DIRECT) {
+        const int32_t * idx = (const int32_t *) (uintptr_t) state_idx->data;
+        return state->data + (uint64_t) idx[piv3] * state->nb[1] + (uint64_t) piv1 * S_v * S_v * sizeof(float);
+    }
+    return state->data + ((uint64_t) piv3 * kp->state_seq_stride + (uint64_t) piv1 * S_v * S_v) * sizeof(float);
+}
