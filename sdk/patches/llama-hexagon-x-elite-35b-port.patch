+static void htp_conv_apply_fold(htp_opnode & node, const htp_conv_fold & f) {
+    auto * kp = node.kparams<htp_ssm_conv_kernel_params>();
+    kp->n_hvx     = f.n_hvx;
+    kp->vtcm_size = f.vtcm;
+    kp->silu      = f.silu ? 1 : 0;
