+// ---- Decode-time GATED_DELTA_NET folds (ported from the sm8750 decode fusion bundle) ----
+//  * state-direct: GET_ROWS(states, s_copy) -> (RESHAPE) -> GDN src[5] is dropped; the kernel reads the slot itself
+//  * gates: ADD(alpha, dt) -> SOFTPLUS -> MUL(A) feeding g and SIGMOID(beta_raw) feeding beta are computed in-kernel
+// Both apply only to one-token, one-sequence graphs on the HVX recurrent kernel; the dropped ops are marked in
+// `folded` and skipped by graph-compute, the GDN op node gets the extra inputs and HTP_GDN_FLAG_* bits.
+struct htp_gdn_fold {
+    const ggml_tensor * states   = nullptr;
+    const ggml_tensor * idx      = nullptr;
+    const ggml_tensor * alpha    = nullptr;
+    const ggml_tensor * beta_raw = nullptr;
+    const ggml_tensor * dt       = nullptr;
+    const ggml_tensor * A        = nullptr;
+};
+
+static const ggml_tensor * htp_gdn_unwrap_view(const ggml_tensor * t) {
+    while (t && (t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE ||
+                 t->op == GGML_OP_TRANSPOSE) && t->src[0]) {
+        t = t->src[0];
+    }
+    return t;
+}
+
+static bool htp_gdn_tensor_local(const ggml_tensor * t) {
+    return t && t->buffer && ggml_backend_buffer_is_hexagon(t->buffer);
+}
+
+// True if `t` (not a view, not an output) is read only by the `st` chain (views/reshapes down to the GDN node `user`)
+// and by zero-element tensors. llama-graph's build_rs adds a zero-row view + copy of the GET_ROWS output when
+// n_rs == n_seqs; it reads nothing, so it must not block the state fold.
+static bool htp_gdn_only_user(const ggml_cgraph * graph, const ggml_tensor * t, const ggml_tensor * st, const ggml_tensor * user) {
+    if (t->view_src || (t->flags & GGML_TENSOR_FLAG_OUTPUT)) return false;
+    for (int i = 0; i < graph->n_nodes; i++) {
+        const ggml_tensor * n = graph->nodes[i];
+        bool uses = false;
+        for (int s = 0; s < GGML_MAX_SRC; s++) uses |= (n->src[s] == t);
+        if (!uses || n == user) continue;
+        bool on_chain = false;
+        for (const ggml_tensor * x = st; x; x = x->src[0]) { if (x == n) { on_chain = true; break; } if (x == t) break; }
+        if (on_chain) continue;
+        if (ggml_nelements(n) == 0) continue;
+        return false;
+    }
+    return true;
+}
+
+static void htp_gdn_prepass(const ggml_cgraph * graph, const ggml_hexagon_session * sess,
+                            std::vector<char> & folded, std::unordered_map<const ggml_tensor *, htp_gdn_fold> & folds) {
+    if (!opt_gdn_fold) return;
+
+    const int n = graph->n_nodes;
+    std::unordered_map<const ggml_tensor *, int> index;
+    index.reserve(n);
+    for (int i = 0; i < n; i++) index[graph->nodes[i]] = i;
+
+    auto node_index = [&](const ggml_tensor * t, int before) -> int {
+        auto it = index.find(t);
+        return (it == index.end() || it->second >= before) ? -1 : it->second;
+    };
+
+    for (int gi = 0; gi < n; gi++) {
+        const ggml_tensor * gdn = graph->nodes[gi];
+        if (gdn->op != GGML_OP_GATED_DELTA_NET || !ggml_hexagon_op_is_compute(gdn)) continue;
+        const ggml_tensor * v  = gdn->src[2];
+        const ggml_tensor * g  = gdn->src[3];
+        const ggml_tensor * b  = gdn->src[4];
+        const ggml_tensor * st = gdn->src[5];
+        if (!v || !g || !b || !st) continue;
+        if (v->ne[2] != 1 || v->ne[3] != 1) continue;   // one token, one sequence
+
+        // the kernel must be the HVX recurrent, non-KDA path
+        {
+            htp_opnode probe(HTP_OP_GATED_DELTA_NET, gdn);
+            if (!htp_kparams_solve(sess, probe)) continue;
+            const auto * kp = probe.kparams<htp_gdn_kernel_params>();
+            if (kp->kernel_type != HTP_GDN_KERNEL_HVX_RECURRENT || kp->kda) continue;
+        }
+
+        htp_gdn_fold f;
+
+        // gates
+        do {
+            const int64_t H = v->ne[1];
+            if (H > 32 || g->ne[0] != 1) break;
+            const ggml_tensor * mul = htp_gdn_unwrap_view(g);
+            const ggml_tensor * sig = htp_gdn_unwrap_view(b);
+            if (!mul || mul->op != GGML_OP_MUL) break;
+            if (!sig || sig->op != GGML_OP_UNARY || ggml_get_unary_op(sig) != GGML_UNARY_OP_SIGMOID) break;
+            const ggml_tensor * sp = mul->src[0];
+            const ggml_tensor * A  = mul->src[1];
+            if (!sp || !A || sp->op != GGML_OP_UNARY || ggml_get_unary_op(sp) != GGML_UNARY_OP_SOFTPLUS) break;
+            const ggml_tensor * add = sp->src[0];
+            if (!add || add->op != GGML_OP_ADD) break;
+            const ggml_tensor * alpha = add->src[0];
+            const ggml_tensor * dt    = add->src[1];
+            const ggml_tensor * braw  = sig->src[0];
+            if (!alpha || !dt || !braw) break;
+            bool ok = true;
+            for (const ggml_tensor * t : { mul, sp, add, sig, alpha, dt, A, braw }) {
+                if (t->type != GGML_TYPE_F32 || ggml_nelements(t) != H) ok = false;
+            }
+            if (!ok) break;
+            if (dt->ne[0] != H || A->ne[0] != H || alpha->nb[0] != sizeof(float) || braw->nb[0] != sizeof(float)) break;
+            if (!(alpha->ne[0] == H || alpha->ne[1] == H) || !(braw->ne[0] == H || braw->ne[1] == H)) break;
+            if (!htp_gdn_tensor_local(alpha) || !htp_gdn_tensor_local(dt) ||
+                !htp_gdn_tensor_local(A)     || !htp_gdn_tensor_local(braw)) break;
+            const int ia = node_index(add, gi), is = node_index(sp, gi), im = node_index(mul, gi), ig = node_index(sig, gi);
+            if (ia < 0 || is < 0 || im < 0 || ig < 0) break;
+            if (!ggml_node_has_n_uses(graph, ia, 1) || !ggml_node_has_n_uses(graph, is, 1) ||
+                !ggml_node_has_n_uses(graph, im, 1) || !ggml_node_has_n_uses(graph, ig, 1)) break;
+            f.alpha = alpha; f.beta_raw = braw; f.dt = dt; f.A = A;
+            folded[ia] = folded[is] = folded[im] = folded[ig] = 1;
+        } while (0);
+
+        // state-direct
+        do {
+            const ggml_tensor * gr = htp_gdn_unwrap_view(st);
+            if (!gr || gr->op != GGML_OP_GET_ROWS) break;
+            const int gri = node_index(gr, gi);
+            if (gri < 0) break;
+            const ggml_tensor * states = gr->src[0];
+            const ggml_tensor * idx    = gr->src[1];
+            if (!states || !idx || states->type != GGML_TYPE_F32 || idx->type != GGML_TYPE_I32 || gr->type != GGML_TYPE_F32) break;
+            if (states->ne[2] != 1 || states->ne[3] != 1 || states->nb[0] != sizeof(float) ||
+                states->nb[1] != (size_t) states->ne[0] * sizeof(float)) break;
+            if (idx->ne[1] != 1 || idx->ne[2] != 1 || idx->ne[3] != 1 || idx->nb[0] != sizeof(int32_t)) break;
+            if (!htp_gdn_only_user(graph, gr, st, gdn)) break;   // zero-row extra-state copy allowed
+            // every view/reshape between the GET_ROWS and the GDN node is read once (ggml_node_has_n_uses rejects
+            // views outright, which is why the state fold never matched)
+            {
+                bool chain_ok = true;
+                for (const ggml_tensor * x = st; x && x != gr; x = x->src[0]) {
+                    const int xi = node_index(x, gi);
+                    if (xi < 0 || ggml_node_get_use_count(graph, xi) != 1 || (x->flags & GGML_TENSOR_FLAG_OUTPUT)) { chain_ok = false; break; }
+                }
+                if (!chain_ok) break;
+            }
+            if (!htp_gdn_tensor_local(states) || !htp_gdn_tensor_local(idx)) break;
+            const int64_t D = st->ne[0] * st->ne[1] * st->ne[2];
+            if (D != states->ne[0] || st->ne[3] != v->ne[3] || idx->ne[0] < v->ne[3]) break;
+            f.states = states; f.idx = idx;
+            folded[gri] = 1;
+        } while (0);
+
+        if (f.alpha || f.states) {
+            folds[gdn] = f;
+        }
+    }
+}
+
+static void htp_gdn_apply_fold(htp_opnode & node, const htp_gdn_fold & f) {
+    auto * kp = node.kparams<htp_gdn_kernel_params>();
+    node.inputs.n = f.alpha ? 9 : 7;   // htp_opvec: slots 6..8 are nullptr until assigned below
+    for (size_t i = 6; i < node.inputs.n; i++) node.inputs[i] = nullptr;
+    if (f.states) {
+        node.inputs[5] = f.states;
+        node.inputs[6] = f.idx;
+        kp->flags |= HTP_GDN_FLAG_STATE_DIRECT;
+    } else {
+        node.inputs[6] = node.inputs[5];   // placeholder, unused without the flag
+    }
+    if (f.alpha) {
+        node.inputs[3] = f.alpha;
+        node.inputs[4] = f.beta_raw;
+        node.inputs[7] = f.dt;
+        node.inputs[8] = f.A;
+        kp->flags |= HTP_GDN_FLAG_GATES;
+    }
+}
+
+// ---- Decode-time SSM_CONV_DIRECT fold ----
+// GET_ROWS(cache_r) -> old; CONCAT(old, x^T) -> cat; CPY(cat[1:], cache_r slot); SSM_CONV(cat, w) -> y; [SILU(y)]
+// becomes one op that reads old/x/w, writes the next state into the cache slot and y (with SiLU) directly.
+// The model graph pins old and x on the SSM_CONV node as src[2]/src[3] (see src/models/qwen35*.cpp).
+struct htp_conv_fold {
+    const ggml_tensor * x     = nullptr;
+    const ggml_tensor * old   = nullptr;
+    const ggml_tensor * w     = nullptr;
+    const ggml_tensor * next  = nullptr;   // CPY node: the recurrent-cache slot view
+    const ggml_tensor * y_out = nullptr;   // y, or the SILU output when folded
+    const ggml_tensor * cpy   = nullptr;
+    const ggml_tensor * silu  = nullptr;
+    uint32_t n_hvx = 0;
+    uint32_t vtcm  = 0;
+};
+
+static bool htp_conv_ranges_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a || !b || !a->data || !b->data) return false;
+    const uintptr_t a0 = (uintptr_t) a->data, a1 = a0 + ggml_nbytes(a);
+    const uintptr_t b0 = (uintptr_t) b->data, b1 = b0 + ggml_nbytes(b);
+    return a0 < b1 && b0 < a1;
+}
+
+static void htp_conv_prepass(const ggml_cgraph * graph, const ggml_hexagon_session * sess,
+                             std::vector<char> & folded, std::unordered_map<const ggml_tensor *, htp_conv_fold> & folds) {
+    if (!opt_conv_fold) return;
+
+    const int n = graph->n_nodes;
+    std::unordered_map<const ggml_tensor *, int> index;
+    index.reserve(n);
+    for (int i = 0; i < n; i++) index[graph->nodes[i]] = i;
+    auto node_index = [&](const ggml_tensor * t) -> int {
+        auto it = index.find(t);
+        return it == index.end() ? -1 : it->second;
+    };
+    auto shape = [](const ggml_tensor * t, int64_t a, int64_t b) {
+        return t && t->type == GGML_TYPE_F32 && t->ne[0] == a && t->ne[1] == b && t->ne[2] == 1 && t->ne[3] == 1;
+    };
+    auto operand = [&](const ggml_tensor * t, int64_t a, int64_t b) {
+        return shape(t, a, b) && ggml_is_contiguous(t) && htp_gdn_tensor_local(t) &&
+               ((reinterpret_cast<uintptr_t>(t->data) & 127) == 0);
+    };
+
+    const uint32_t sess_n_hvx = htp_session_n_hvx(sess);
+    const size_t   sess_vtcm  = htp_session_vtcm_size(sess);
+
+    for (int yi = 0; yi < n; yi++) {
+        const ggml_tensor * y = graph->nodes[yi];
+        if (y->op != GGML_OP_SSM_CONV || !ggml_hexagon_op_is_compute(y) || !y->src[2] || !y->src[3]) continue;
+        const ggml_tensor * cat = y->src[0];
+        const ggml_tensor * w   = y->src[1];
+        const ggml_tensor * old = y->src[2];
+        const ggml_tensor * x   = y->src[3];
+        const int64_t C = y->ne[0];
+        const int64_t T = y->ne[1];
+        if (T < 1 || T > HTP_SSM_DIRECT_MAX_T || C <= 0 || (C % HTP_SSM_DIRECT_SLICE) != 0 || y->ne[2] != 1) continue;
+        if (!operand(y, C, T) || !operand(x, C, T) || !operand(old, 3, C) || !operand(w, 4, C) ||
+            !operand(cat, T + 3, C) || cat->op != GGML_OP_CONCAT || cat->view_src ||
+            ggml_get_op_params_i32(cat, 0) != 0 || cat->src[0] != old || cat->src[2]) continue;
+        const ggml_tensor * xt = cat->src[1];
+        if (!xt || xt->op != GGML_OP_TRANSPOSE || xt->src[0] != x || xt->ne[0] != T || xt->ne[1] != C ||
+            xt->data != x->data || xt->nb[0] != x->nb[1] || xt->nb[1] != x->nb[0]) continue;
+        const int ci = node_index(cat);
+        if (ci < 0 || ci >= yi) continue;
+
+        // the state write-back: CPY(view(cat, [3, C] at +T floats), cache slot)
+        htp_conv_fold f;
+        int cpi = -1;
+        for (int k = ci + 1; k < yi; k++) {
+            const ggml_tensor * cp = graph->nodes[k];
+            if (cp->op != GGML_OP_CPY || !cp->src[0] || !cp->src[1]) continue;
+            const ggml_tensor * sv = cp->src[0];
+            if (sv->op != GGML_OP_VIEW || sv->view_src != cat || sv->view_offs != (size_t) T * sizeof(float) ||
+                sv->type != GGML_TYPE_F32 || sv->ne[0] != 3 || sv->ne[1] != C || sv->ne[2] != 1 || sv->ne[3] != 1 ||
+                sv->nb[0] != sizeof(float) || sv->nb[1] != cat->nb[1]) continue;
+            const ggml_tensor * dstv = cp->src[1];
+            if (!shape(dstv, 3 * C, 1) || !ggml_is_contiguous(dstv) || !htp_gdn_tensor_local(dstv) ||
+                cp->type != GGML_TYPE_F32 || cp->data != dstv->data || ggml_nbytes(cp) != ggml_nbytes(dstv) ||
+                ((reinterpret_cast<uintptr_t>(cp->data) & 127) != 0)) continue;
+            cpi = k;
+            f.next = cp;
+            f.cpy  = cp;
+            break;
+        }
+        if (cpi < 0) continue;
+        if (!ggml_node_has_n_uses(graph, ci, 2)) continue;   // the conv and the write-back view
+
+        // nothing else between the concat and the conv may touch these buffers
+        bool clean = true;
+        for (int k = ci + 1; k < yi && clean; k++) {
+            const ggml_tensor * t = graph->nodes[k];
+            if (k == cpi || (t->op == GGML_OP_VIEW && t->view_src == cat)) continue;
+            if (!ggml_hexagon_op_is_compute(t)) continue;
+            if (htp_conv_ranges_overlap(t, cat) || htp_conv_ranges_overlap(t, f.next) ||
+                htp_conv_ranges_overlap(t, old) || htp_conv_ranges_overlap(t, x)) clean = false;
+            for (int si = 0; si < GGML_MAX_SRC && clean; si++) {
+                const ggml_tensor * sv = t->src[si];
+                if (sv && (htp_conv_ranges_overlap(sv, cat) || htp_conv_ranges_overlap(sv, f.next))) clean = false;
+            }
+        }
+        if (!clean) continue;
+        // y may alias x exactly (ggml-alloc reuses x's bytes; the kernel reads each x slice before writing its y slice)
+        auto same_bytes = [](const ggml_tensor * a, const ggml_tensor * b) {
+            return a->data == b->data && ggml_nbytes(a) == ggml_nbytes(b);
+        };
+        if (htp_conv_ranges_overlap(f.next, old) || htp_conv_ranges_overlap(f.next, x) || htp_conv_ranges_overlap(f.next, w) ||
+            htp_conv_ranges_overlap(y, old) || (htp_conv_ranges_overlap(y, x) && !same_bytes(y, x)) ||
+            htp_conv_ranges_overlap(y, w) || htp_conv_ranges_overlap(y, f.next)) {
+            HEX_VERBOSE("ggml-hex: %s conv-fold skip %s: output overlaps an input\n", sess->c_name(), y->name);
+            continue;
+        }
+
+        // optional SiLU on y
+        f.y_out = y;
+        if (ggml_node_has_n_uses(graph, yi, 1)) {
+            for (int k = yi + 1; k < n && k <= yi + 2; k++) {
+                const ggml_tensor * sn = graph->nodes[k];
+                if (sn->op == GGML_OP_UNARY && ggml_get_unary_op(sn) == GGML_UNARY_OP_SILU && sn->src[0] == y &&
+                    ggml_hexagon_op_is_compute(sn) && ggml_are_same_layout(y, sn) && htp_gdn_tensor_local(sn) &&
+                    ((reinterpret_cast<uintptr_t>(sn->data) & 127) == 0) &&
