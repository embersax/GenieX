diff --git a/ggml/src/ggml-hexagon/htp/qedge_prefill4/candidate.c b/ggml/src/ggml-hexagon/htp/qedge_prefill4/candidate.c
new file mode 100644
index 000000000..684cd9fd4
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/qedge_prefill4/candidate.c
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: MIT
+ * Qf32 convolution and four-tap weight deinterleave adapted from llama.cpp,
+ * commit 94256114c229674ef96e76eb2dea596e65b43818, ggml-hexagon/htp/ssm-conv.c.
+ * See LICENSE.llama.cpp. Token-major carry follows the verified direct prototype.
+ */
+#include "kernel.h"
+#include <hexagon_types.h>
+#include <hexagon_protos.h>
+#include <hvx_hexagon_protos.h>
+
+void prefill4_hvx(const float *restrict x, const float *restrict old,
+                 const float *restrict weight, float *restrict y, float *restrict next,
+                 unsigned tokens, unsigned channels) {
+    union { HVX_Vector vec[3]; float f[3][32]; } history[KDA_MAX_C/32];
+    HVX_Vector wt[KDA_MAX_C/32][4];
+    kda_phase_begin(KDA_PREP);
+    for (unsigned c = 0; c < channels; c += 32) {
+        const unsigned block = c / 32;
+        const HVX_Vector *w = (const HVX_Vector *)(weight + 4*c);
+        HVX_VectorPair p01 = Q6_W_vdeal_VVR(w[1], w[0], -4);
+        HVX_VectorPair p23 = Q6_W_vdeal_VVR(w[3], w[2], -4);
+        HVX_VectorPair p02 = Q6_W_vdeal_VVR(Q6_V_lo_W(p23), Q6_V_lo_W(p01), -4);
+        HVX_VectorPair p13 = Q6_W_vdeal_VVR(Q6_V_hi_W(p23), Q6_V_hi_W(p01), -4);
+        wt[block][0] = Q6_V_lo_W(p02);
+        wt[block][1] = Q6_V_lo_W(p13);
+        wt[block][2] = Q6_V_hi_W(p02);
+        wt[block][3] = Q6_V_hi_W(p13);
+        for (unsigned j = 0; j < 32; ++j) {
+            history[block].f[0][j] = old[3*(c+j)];
+            history[block].f[1][j] = old[3*(c+j)+1];
+            history[block].f[2][j] = old[3*(c+j)+2];
+        }
+    }
+    kda_phase_end(KDA_PREP);
+    kda_phase_begin(KDA_CONV);
+    for (unsigned c = 0; c < channels; c += 32) {
+        const unsigned block = c / 32;
+        HVX_Vector h0 = history[block].vec[0], h1 = history[block].vec[1], h2 = history[block].vec[2];
+        const HVX_Vector w0 = wt[block][0], w1 = wt[block][1], w2 = wt[block][2], w3 = wt[block][3];
+        #pragma clang loop unroll_count(4)
+        for (unsigned t = 0; t < tokens; ++t) {
+            HVX_Vector x3 = *(const HVX_Vector *)(x + t*channels + c);
+            HVX_Vector sum = Q6_V_vzero();
+            sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(h0, w0));
+            sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(h1, w1));
+            sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(h2, w2));
+            sum = Q6_Vqf32_vadd_Vqf32Vqf32(sum, Q6_Vqf32_vmpy_VsfVsf(x3, w3));
+            *(HVX_Vector *)(y + t*channels + c) = Q6_Vsf_equals_Vqf32(sum);
+            h0 = h1; h1 = h2; h2 = x3;
+        }
+    }
+    kda_phase_end(KDA_CONV);
+    kda_phase_begin(KDA_STATE);
+    for (unsigned c = 0; c < channels; c += 32) {
+        const unsigned block = c / 32;
+        const float *last = x + (tokens-1)*channels + c;
+        HVX_Vector r2 = *(const HVX_Vector *)last;
+        HVX_Vector r1 = tokens >= 2 ? *(const HVX_Vector *)(last - channels)
+                                    : history[block].vec[2];
+        HVX_Vector r0 = tokens >= 3 ? *(const HVX_Vector *)(last - 2*channels)
+                                    : history[block].vec[tokens];
+
+        // Form eight (r0, r1, r2, pad) quads in each vector.
+        HVX_VectorPair ab = Q6_W_vshuff_VVR(r1, r0, -4);
+        HVX_VectorPair cc = Q6_W_vshuff_VVR(r2, r2, -4);
+        HVX_VectorPair lo = Q6_W_vshuff_VVR(Q6_V_lo_W(cc), Q6_V_lo_W(ab), -8);
+        HVX_VectorPair hi = Q6_W_vshuff_VVR(Q6_V_hi_W(cc), Q6_V_hi_W(ab), -8);
+        HVX_Vector q0 = Q6_V_lo_W(lo), q1 = Q6_V_hi_W(lo);
+        HVX_Vector q2 = Q6_V_lo_W(hi), q3 = Q6_V_hi_W(hi);
+
+        // Reverse delta compacts the 24 live words into the low 96 bytes.
+        // Tracing output word i backwards through strides 16,8,4,2,1
+        // routes it to input word i+i/3. Each byte of a word follows that route.
+        static const HVX_Vector compact = {
+            0x00000000, 0x00000000, 0x00000000, 0x10101010,
+            0x04040404, 0x0c0c0c0c, 0x20202020, 0x2c2c2c2c,
+            0x08080808, 0x10101010, 0x18181818, 0x18181818,
+            0x44444444, 0x44444444, 0x58585858, 0x54545454,
+            0x10101010, 0x10101010, 0x20202020, 0x20202020,
+            0x34343434, 0x3c3c3c3c, 0x30303030, 0x2c2c2c2c,
+            0x08080808, 0x00000000, 0x08080808, 0x08080808,
+            0x34343434, 0x24242424, 0x28282828, 0x24242424
+        };
+        HVX_Vector a = Q6_V_vrdelta_VV(q0, compact);
+        HVX_Vector b = Q6_V_vrdelta_VV(q1, compact);
+        HVX_Vector c2 = Q6_V_vrdelta_VV(q2, compact);
+        HVX_Vector d = Q6_V_vrdelta_VV(q3, compact);
+
+        // Put the low 96 bytes of the left chunk at the high end, then
+        // splice 96+32, 64+64 and 32+96 bytes into three aligned stores.
+        HVX_Vector *dst = (HVX_Vector *)(next + 3*c);
+        dst[0] = Q6_V_valign_VVR(b, Q6_V_vror_VR(a, 96), 32);
+        dst[1] = Q6_V_valign_VVR(c2, Q6_V_vror_VR(b, 96), 64);
+        dst[2] = Q6_V_valign_VVR(d, Q6_V_vror_VR(c2, 96), 96);
+    }
+    kda_phase_end(KDA_STATE);
+}
