+    node.inputs.push_back(f.x);
+    node.inputs.push_back(f.old);
+    node.inputs.push_back(f.w);
+    node.outputs.clear();
+    node.outputs.push_back(f.next);
+    node.outputs.push_back(f.y_out);
+    node.fused.push_back(f.cpy);
+    if (f.silu) node.fused.push_back(f.silu);
+}
