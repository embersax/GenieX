+}
+
+static inline float gdn_gate_elem(const struct htp_tensor * t, uint32_t h) {
+    const size_t stride = (t->ne[0] > 1) ? t->nb[0] : t->nb[1];
+    return *(const float *) ((const uint8_t *) (uintptr_t) t->data + (size_t) h * stride);
+}
+
+// Same instruction sequence as hvx_softplus_f32_aa in unary-ops.c (x for x > 20, else log(1 + exp(x))).
+static inline void gdn_softplus_f32_aa(uint8_t * restrict dst, const uint8_t * restrict src, uint32_t n) {
+    const HVX_Vector * restrict v_src = (const HVX_Vector *) src;
+    HVX_Vector * restrict v_dst       = (HVX_Vector *) dst;
+    const HVX_Vector twenty = hvx_vec_splat_f32(20.0f);
+    const HVX_Vector one    = hvx_vec_splat_f32(1.0f);
+    const uint32_t nvec = n / VLEN_FP32;
+    const uint32_t nloe = n % VLEN_FP32;
+    for (uint32_t i = 0; i < nvec; i++) {
+        HVX_Vector x             = v_src[i];
+        HVX_VectorPred pred_gt20 = Q6_Q_vcmp_gt_VsfVsf(x, twenty);
+        HVX_Vector expx          = hvx_vec_exp_f32(x);
+        HVX_Vector logv          = hvx_vec_log_f32(hvx_vec_add_f32_f32(one, expx));
+        v_dst[i]                 = Q6_V_vmux_QVV(pred_gt20, x, logv);
+    }
+    if (nloe > 0) {
+        HVX_Vector x             = v_src[nvec];
+        HVX_VectorPred pred_gt20 = Q6_Q_vcmp_gt_VsfVsf(x, twenty);
+        HVX_Vector expx          = hvx_vec_exp_f32(x);
+        HVX_Vector logv          = hvx_vec_log_f32(hvx_vec_add_f32_f32(one, expx));
+        HVX_Vector sp            = Q6_V_vmux_QVV(pred_gt20, x, logv);
+        hvx_vec_store_a((void *) &v_dst[nvec], nloe * sizeof(float), sp);
+    }
+}
