+static inline float gdn_gate_elem(const struct htp_tensor * t, uint32_t h) {
+    const size_t stride = (t->ne[0] > 1) ? t->nb[0] : t->nb[1];
+    return *(const float *) ((const uint8_t *) (uintptr_t) t->data + (size_t) h * stride);
+}
